# Copia este archivo a backend/.env (nunca subas .env al repo).

# localhost | stage | production
ENVIRONMENT=localhost
# Local: Postgres de docker compose. Stage/producción: "Session pooler" de Supabase.
DATABASE_URL=postgresql+psycopg://ayni:ayni@localhost:5432/ayni
JWT_SECRET=genera-uno-con-openssl-rand-hex-32

# Supabase Storage (fotos en un bucket privado, servidas con URLs firmadas)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fotos

# LLM en free tier (módulo nlp), en console.groq.com. Si falta, se usa spaCy como respaldo.
GROQ_API_KEY=
# Opcionales: modelo de Groq y segundos antes de pasar a spaCy
# GROQ_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT_SECONDS=5

# Pagos SIMULADOS (módulo billing): solo credenciales de prueba de Mercado Pago (TEST-...)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Frontend (frontend/.env.local)
VITE_API_URL=http://localhost:8000
